msgid "rank scores computed elsewhere"
msgstr ""

#: manual/tutorial/score.md:16
msgid "`@score.rank_positions(scores)` and `@score.rank_label(position, population, score)`"
msgstr ""

#: manual/tutorial/score.md:17
msgid "label a 30-day change"
msgstr ""

#: manual/tutorial/score.md:18
msgid "count signals from release records"
msgstr ""

